{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@shared-types/photoshop/*": ["src/shared/types/photoshop/src/*"],
      "@shared-types/uxp/*": ["src/shared/types/uxp/src/*"],
      "@test/*": ["test/*"],
      "@webview/*": ["src/webview/*"],
      "@uxp/*": ["src/uxp/*"]
    },
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
