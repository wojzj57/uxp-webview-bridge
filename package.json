{
  "name": "uxp-webview-bridge",
  "version": "0.0.0",
  "description": "Bridge library for Adobe UXP plugin hosts and WebView clients.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CONTEXT.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./webview": {
      "types": "./dist/webview/index.d.ts",
      "import": "./dist/webview/index.js"
    },
    "./uxp": {
      "types": "./dist/uxp/index.d.ts",
      "import": "./dist/uxp/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@bubblydoo/uxp-cli": "^0.0.12",
    "@types/node": "^20.14.12",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4"
  }
}
